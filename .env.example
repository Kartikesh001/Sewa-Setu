# ==============================================================================
# Sewa Setu - Production Environment Variables Template
# Copy this file to '.env' on the production server:
#   cp .env.example .env
#
# IMPORTANT:
# - Generate unique, high-entropy secrets using: openssl rand -hex 32
# - Do NOT commit the populated '.env' file to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=sewasetu
DB_USER=sewasetu
# Set a strong, randomly generated database password (e.g., openssl rand -hex 16)
DB_PASSWORD=generate_a_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 2. Portal & Session Security
# ------------------------------------------------------------------------------
# Flask session secret key (generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_cryptographically_secure_flask_secret_key_here

# Administrative portal credentials for /admin and /admin/tokens
ADMIN_USERNAME=sewasetu_admin
ADMIN_PASSWORD=generate_a_strong_unique_admin_password_here

# ------------------------------------------------------------------------------
# 3. Hostname & Domain Configuration
# ------------------------------------------------------------------------------
# Canonical public base URL reachable by citizens and MCP agents.
# Example: https://pension.yourdomain.gov.in OR http://<VPS_PUBLIC_IP>
# NOTE: No trailing slash! This URL is stamped into OAuth discovery and tokens.
PUBLIC_BASE_URL=http://your-vps-ip-or-domain

# Server Timezone (Statutory Purvanchal portal clock)
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# 4. Scheme Rules & Thresholds
# ------------------------------------------------------------------------------
MIN_AGE=60
SLA_DAYS=15
SCHEME_DEADLINE=2026-10-31 23:59
OTP_VALIDITY_SECONDS=600

# ------------------------------------------------------------------------------
# 5. Internal Service URLs (Default Docker Bridge Network bindings)
# ------------------------------------------------------------------------------
# These internal references are resolved across the Docker network bridge.
SMS_GATEWAY_URL=http://smsgw:8025
UPLOAD_DIR=/var/sewasetu/uploads
